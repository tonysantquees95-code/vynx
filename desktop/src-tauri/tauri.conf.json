{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vynx OS",
  "version": "1.0.0",
  "identifier": "tech.vetorial.vynx",
  "build": {
    "beforeBuildCommand": "cd ../app && npm run build",
    "beforeDevCommand": "cd ../app && npm run dev",
    "devUrl": "http://localhost:5179",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vynx OS",
        "width": 1000,
        "height": 720,
        "minWidth": 380,
        "minHeight": 560,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; frame-src https://venus-servidor.tonysantquees95.workers.dev; connect-src 'self' https://api.github.com https://venus-servidor.tonysantquees95.workers.dev ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
